{
  "$defs": {
    "ButtonNode": {
      "additionalProperties": false,
      "description": "Button 节点 — 叶子",
      "properties": {
        "id": {
          "description": "节点唯一标识符，格式：小写字母开头，段间用 . 或 - 分隔",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[.\\-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "props": {
          "$ref": "#/$defs/ButtonProps"
        },
        "style": {
          "anyOf": [
            {
              "$ref": "#/$defs/Style"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type": {
          "const": "Button",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "props"
      ],
      "title": "ButtonNode",
      "type": "object"
    },
    "ButtonProps": {
      "additionalProperties": false,
      "description": "Button 组件属性，禁止事件字段",
      "properties": {
        "disabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disabled"
        },
        "text": {
          "maxLength": 200,
          "title": "Text",
          "type": "string"
        },
        "variant": {
          "anyOf": [
            {
              "enum": [
                "primary",
                "secondary",
                "ghost"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variant"
        }
      },
      "required": [
        "text"
      ],
      "title": "ButtonProps",
      "type": "object"
    },
