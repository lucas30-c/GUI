    "Style": {
      "additionalProperties": false,
      "description": "受控 Style DSL v2 — Box Model + Layout + Typography + Border。\n\n31 个白名单字段，extra=forbid 拒绝一切未列出属性。\n每个字段使用其专属值域类型（CssLength / MarginAtom / MarginShorthand /\nPaddingShorthand / LineHeight / Color / 枚举），不再共用单一尺寸正则。\n字段的机器可读元数据由 contracts.style_registry 从本模型派生（单一事实来源）。",
      "properties": {
        "alignItems": {
          "anyOf": [
            {
              "enum": [
                "flex-start",
                "flex-end",
                "center",
                "stretch",
                "baseline"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alignitems"
        },
        "backgroundColor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backgroundcolor"
        },
        "borderColor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bordercolor"
        },
        "borderRadius": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Borderradius"
        },
        "borderStyle": {
          "anyOf": [
            {
              "enum": [
                "solid",
                "dashed",
                "dotted",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Borderstyle"
        },
        "borderWidth": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Borderwidth"
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "columnGap": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Columngap"
        },
        "display": {
          "anyOf": [
            {
              "enum": [
                "block",
                "flex",
                "grid",
                "inline",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
