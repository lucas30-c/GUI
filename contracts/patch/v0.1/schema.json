  "additionalProperties": false,
  "description": "Patch v0.1 文档顶层结构",
  "properties": {
    "operations": {
      "items": {
        "discriminator": {
          "mapping": {
            "update_props": "#/$defs/UpdatePropsOperation",
            "update_style": "#/$defs/UpdateStyleOperation"
          },
          "propertyName": "op"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/UpdatePropsOperation"
          },
          {
            "$ref": "#/$defs/UpdateStyleOperation"
          }
        ]
      },
      "minItems": 1,
      "title": "Operations",
      "type": "array"
    },
    "version": {
      "const": "0.1",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "version",
    "operations"
  ],
  "title": "PatchDocument",
  "type": "object",
  "x-patch-version": "0.1"
}
