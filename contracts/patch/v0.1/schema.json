        "targetNodeId",
        "props"
      ],
      "title": "UpdatePropsOperation",
      "type": "object"
    },
    "UpdateStyleOperation": {
      "additionalProperties": false,
      "description": "单个 update_style 操作（与 UpdatePropsOperation 逐项同构，DD-01）",
      "properties": {
        "op": {
          "const": "update_style",
          "title": "Op",
          "type": "string"
        },
        "style": {
          "$ref": "#/$defs/Style"
        },
        "targetNodeId": {
          "minLength": 1,
          "title": "Targetnodeid",
          "type": "string"
        }
      },
      "required": [
        "op",
        "targetNodeId",
        "style"
      ],
      "title": "UpdateStyleOperation",
      "type": "object"
