    "UpdatePropsOperation": {
      "additionalProperties": false,
      "description": "单个 update_props 操作",
      "properties": {
        "op": {
          "const": "update_props",
          "title": "Op",
          "type": "string"
        },
        "props": {
          "additionalProperties": true,
          "title": "Props",
          "type": "object"
        },
        "targetNodeId": {
          "minLength": 1,
          "title": "Targetnodeid",
          "type": "string"
        }
      },
      "required": [
